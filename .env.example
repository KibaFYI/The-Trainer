# ── axolotl-forge environment ─────────────────────────────────────────────────────
# Paste into a RunPod / Vast / Lambda template, or: docker run --env-file .env ...
# (docker env files do not allow comments after a value, so every comment has its own line)

# ── what to train ────────────────────────────────────────────────────────────────
# Any link type: HF id/url, https://, Google Drive, s3://, local path.
# Leave both empty for the guided `forge` wizard; fill both to train on boot.
# e.g. FORGE_MODEL=Qwen/Qwen3-8B
# e.g. FORGE_DATASET=https://huggingface.co/datasets/mlabonne/FineTome-100k
FORGE_MODEL=
FORGE_DATASET=
# auto | lora | qlora | full
FORGE_METHOD=auto
# free text for the AI, e.g. roleplay chat, 8k context, 2 epochs
FORGE_GOAL=
# skip AI generation and use this yaml (path or url)
# FORGE_CONFIG=

# ── AI config writer ─────────────────────────────────────────────────────────────
# Set ONE key (auto-detected) or use a custom endpoint.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# FORGE_LLM_PROVIDER=custom
# FORGE_LLM_BASE_URL=http://my-vllm:8000/v1
# FORGE_LLM_API_KEY=
# openai | anthropic  (shape of the custom endpoint)
# FORGE_LLM_API_STYLE=openai
# override the provider's default model
# FORGE_LLM_MODEL=
# Claude effort: low | medium | high | xhigh | max
# FORGE_LLM_EFFORT=high
# random dataset sectors shown to the AI
# FORGE_SAMPLE_COUNT=5

# ── upload to the Hugging Face Hub when training finishes ───────────────────────
HF_TOKEN=
FORGE_UPLOAD=1
# your user, an org name, or "ask" (pick from your list; unattended runs use your user)
FORGE_HUB_NAMESPACE=ask
# repo name (default: <model>-<dataset>-<method>), or the full namespace/name in FORGE_HUB_REPO
# FORGE_HUB_NAME=
# FORGE_HUB_REPO=
FORGE_HUB_PRIVATE=1
# auto | adapter | merged | both | full
FORGE_UPLOAD_WHAT=auto
# merge LoRA into the base after training: auto | 1 | 0
FORGE_MERGE=auto

# ── notifications + retries ──────────────────────────────────────────────────────
# Discord pings: training done · uploaded · all finished · failed
FORGE_DISCORD_WEBHOOK=
# a training crash goes to the AI for a fixed config; this many attempts in total
FORGE_TRAIN_ATTEMPTS=3

# ── box ──────────────────────────────────────────────────────────────────────────
# 0 = don't pop up the wolfgon setup screen on login
# FORGE_SETUP_SCREEN=1
# ssh public key (RunPod sets PUBLIC_KEY for you)
PUBLIC_KEY=
# enables password ssh login
# ROOT_PASSWORD=
# tensorboard on :6006
# FORGE_TENSORBOARD=1
# runs after the pipeline ends (success or not), e.g. stop the pod to stop paying
# FORGE_ON_FINISH_CMD=runpodctl stop pod $RUNPOD_POD_ID
# pick your purple
# FORGE_PURPLE=#B388FF
